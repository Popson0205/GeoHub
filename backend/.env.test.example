# Settings for the backend test suite (copy to .env.test). Points at local services:
# PostGIS on 5432, Redis on 6379, and moto (an S3 stand-in) on 5555.
ENV=test
DATABASE_URL=postgresql://hub:hub@localhost:5432/hub_test
REDIS_URL=redis://localhost:6379/1
JWT_SECRET=test-secret-not-for-production-0123456789
S3_ENDPOINT=http://localhost:5555
S3_PUBLIC_ENDPOINT=http://localhost:5555
S3_ACCESS_KEY=test
S3_SECRET_KEY=test
S3_BUCKET=hub-test
JOBS_INLINE=true
RATE_LIMIT_ENABLED=true
REMINDERS_ENABLED=false
